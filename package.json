    "url": "https://github.com/CoconutsXXS/Splatoon-Blender/issues"
  },
  "homepage": "https://github.com/CoconutsXXS/Splatoon-Blender#readme",
  "dependencies": {
    "vite": "^5.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "three": "0.174.0"
  }
}
