{
  "name": "splatoon-blender",
  "version": "1.1.2",
  "description": "",
  "main": "3D.js",
  "scripts": {
    "test": "node --test scripts/offline.test.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/copy-offline-assets.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:dev": "node scripts/run-tauri.mjs dev",
    "desktop:build": "node scripts/run-tauri.mjs build",
    "desktop:build:macos": "node scripts/run-tauri.mjs build --target universal-apple-darwin",
    "deploy": "gh-pages -d dist",
    "desktop:build:windows": "node scripts/build-windows.mjs",
    "desktop:pack:resources": "python3 scripts/pack-resources.py",
    "desktop:release:collect": "node scripts/collect-offline-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoconutsXXS/Splatoon-Blender.git"
